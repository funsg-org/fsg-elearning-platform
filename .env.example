# Copiar este archivo como .env.
# El ambiente AWS y la rama Git son independientes.
ENVIRONMENT=qa
# Si se omite, DEPLOYMENT_BRANCH toma el mismo valor de ENVIRONMENT.
# También admite ramas específicas por cliente, por ejemplo epico-production.
DEPLOYMENT_BRANCH=qa

# Código de centro de costo definido por Finanzas.
# Propuesta desarrollo: FSG-ELRN-EPICO-DEV
# Propuesta QA: FSG-ELRN-EPICO-QA
# Propuesta producción: FSG-ELRN-EPICO-PROD
TAG_COST_CENTER=PENDING
TRUSTED_PRINCIPAL_ARN=PENDING
MEDIA_CORS_ALLOWED_ORIGINS=PENDING

# Opcionales; normalmente se conservan sin cambios.
CLIENT_CODE=epico
RESOURCE_PREFIX=epico
TAG_CLIENT=EPICO

# No colocar credenciales, tokens, contraseñas, Account ID ni Outputs AWS aquí.
# RESOURCE_SUFFIX, TAG_ENVIRONMENT, SSM_BASE_PATH y nombres de secretos se derivan.
