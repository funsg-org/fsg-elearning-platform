# Copiar este archivo como .env únicamente cuando se necesiten sobrescrituras
# locales. Los valores no sensibles base viven en config/naming.env y
# config/tags.env.

# Ejemplos de sobrescritura por instalación/ambiente:
CLIENT_CODE=epico
RESOURCE_PREFIX=epico
RESOURCE_SUFFIX=production
ENVIRONMENT=production
TAG_CLIENT=EPICO
TAG_ENVIRONMENT=production

# Completar con el código administrativo que defina FSG antes de analizar
# costos. No colocar credenciales ni secretos en este archivo.
TAG_COST_CENTER=PENDING
