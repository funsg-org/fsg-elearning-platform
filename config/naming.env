# Configuración técnica común de la solución.
SOLUTION_NAME=E-Learning
PROJECT_CODE=fsg-elearning
CLIENT_CODE=epico

# Convención: <RESOURCE_PREFIX>-<servicio>-<RESOURCE_SUFFIX>
RESOURCE_PREFIX=epico
RESOURCE_SUFFIX=production
ENVIRONMENT=production

# Región obligatoria para esta solución.
AWS_REGION=us-east-1

# Ruta base futura para parámetros no sensibles generados por AWS.
SSM_BASE_PATH=/epico/production
SERVERLESS_ACCESS_KEY_SECRET_ID=epico/production/serverless/access-key
